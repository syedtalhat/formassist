{
  "name": "formassist-functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "serve:standalone": "npm run build && node -e \"process.env.STANDALONE='true'; require('./lib/index.js');\"",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run serve:standalone",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "typescript": "^5.7.3"
  },
  "private": true
}
